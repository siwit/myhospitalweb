# Provider ID / MOPH Health ID
# LOCALHOST (Laragon): คัดลอกเป็น .env.myhospital และวางไว้ที่ C:\laragon\www\myhospitalweb\.env.myhospital
# ใช้ Redirect URI: http://127.0.0.1/myhospitalweb/login.php
# PRODUCTION (DirectAdmin): วาง .env.myhospital ไว้นอก public_html ที่ domains/<domain>/environment/myhospitalweb/
# ใช้ Redirect URI ของโดเมนจริง เช่น https://myhospital.moph.go.th/login.php
# ห้ามใส่ secret จริงในไฟล์นี้หรือ commit ขึ้น Git
# ใส่ค่าจริงใน Environment Variables ของ Laragon/Apache เท่านั้น
PROVIDERID_ENABLED=false
HEALTH_ID_CLIENT_ID=
HEALTH_ID_CLIENT_SECRET= 
HEALTH_ID_REDIRECT_URI=
PROVIDER_CLIENT_ID=
PROVIDER_SECRET_KEY=

# HIS slave for OPD wait-time dashboard
HIS_DB_HOST=192.168.xx.xx
HIS_DB_NAME=myhpt_slave
HIS_DB_USER=
HIS_DB_PASS=
HIS_DB_CHARSET=utf8mb4

# Wait-time ingest token (must match waittime_api)
WAITTIME_INGEST_TOKEN=
WAITTIME_SOURCE=local
